---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import BackToPrev from "@components/BackToPrev.astro";
import Link from "@components/Link.astro";
import { Image } from 'astro:assets';
import { Icon } from "astro-icon/components";

export async function getStaticPaths() {
    const projects = (await getCollection("projects"))
        .filter((post) => !post.data.draft)
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
    return projects.map((project) => ({
        params: { slug: project.slug },
        props: project,
    }));
}
type Props = CollectionEntry<"projects">;

const project = Astro.props;
const { Content } = await project.render();
---

<PageLayout title={project.data.title} description={project.data.description}>
    <Container>
        <div class="animate">
            <BackToPrev href="/projects">Back to projects</BackToPrev>
        </div>
        <div class="animate">
            <div class="flex justify-between items-start gap-4 my-10">
                <div class="flex items-center gap-4">
                    <div class="flex-shrink-0">
                        <Image
                                src={project.data.thumbnailURL ? `${Astro.site}thumbnails/${project.data.thumbnailURL}` : `${Astro.site}thumbnails/default.png`}
                                height={100}
                                width={100}
                                alt={`${project.data.title} thumbnail`}
                                class="w-20 h-20 object-contain rounded-lg overflow-hidden border-none"
                        />
                    </div>
                    <div class="flex flex-col">
                        <h2 class="text-xl font-semibold text-black dark:text-white">{project.data.title}</h2>
                        <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">{project.data.description}</p>
                        {(project.data.websiteURL || project.data.repoURL) && (
                                <nav class="flex gap-2 mt-3">
                                    {project.data.docsURL && (
                                            <Link href={project.data.docsURL} external>
                                                <Icon name="book" class="h-5 w-5" />
                                            </Link>
                                    )}
                                    {project.data.websiteURL && (
                                            <Link href={project.data.websiteURL} external>
                                                <Icon name="link" class="h-5 w-5" />
                                            </Link>
                                    )}
                                    {project.data.websiteURL && project.data.repoURL && <span></span>}
                                    {project.data.repoURL && (
                                            <Link href={project.data.repoURL} external>
                                                <Icon name="github" class="h-5 w-5" />
                                            </Link>
                                    )}
                                </nav>
                        )}
                    </div>
                </div>
                <div class="flex flex-col items-end text-sm text-gray-700 dark:text-gray-300">
                    <div class="flex items-center gap-1">
                        <span>State:</span>
                        {project.data.activelyBeingDeveloped ? 'Active' : 'Inactive'}
                        <Icon
                                title={project.data.activelyBeingDeveloped ? 'Active' : 'Inactive'}
                                name={project.data.activelyBeingDeveloped ? 'check' : 'cross'}
                                class={`h-5 w-5 ${project.data.activelyBeingDeveloped ? 'text-green-500' : 'text-red-500'}`}
                        />
                    </div>
                    <span class="mt-1">Launched: {project.data.launchYear}</span>
                </div>
            </div>
        </div>
        <article class="animate">
            <Content />
        </article>
        {project.data.repoURL && project.data.displayGitHubBlock === true && (
                <div class="animate">
                <section
                        id="github-info"
                        class="my-10 p-4 bg-none border-t border-gray-200 dark:border-gray-700/40"
                        data-repo-url={project.data.repoURL}
                >
                    <div class="mb-6">
                        <Icon name="github" class="h-5 w-5 mr-2 inline" />
                        <span class="uppercase text-xs">Github Details</span>
                    </div>
                    <div id="loading-spinner" class="flex justify-center items-center h-20">
                        <div class="spinner border-4 border-gray-300 border-t-gray-600 rounded-full w-8 h-8 animate-spin"></div>
                    </div>
                    <div id="github-data" class="hidden"></div>
                </section>
                </div>
        )}
    </Container>
    <script type="module">
        const githubInfoSection = document.querySelector("#github-info");
        const repoURL = githubInfoSection?.getAttribute("data-repo-url");

        if (repoURL) {
            const spinner = document.querySelector("#loading-spinner");
            const githubDataContainer = document.querySelector("#github-data");

            async function fetchGitHubData(repoURL) {
                try {
                    const match = repoURL.match(/https:\/\/github\.com\/([^/]+)\/([^/]+)/);
                    if (!match) throw new Error("Invalid GitHub repo URL");
                    const [_, owner, repo] = match;
                    const repoResponse = await fetch(`https://api.github.com/repos/${owner}/${repo}`);
                    const repoData = await repoResponse.json();
                    const commitsResponse = await fetch(`https://api.github.com/repos/${owner}/${repo}/commits?per_page=1`);
                    const commitsData = await commitsResponse.json();
                    let totalCommits = "N/A";
                    const linkHeader = commitsResponse.headers.get("Link");
                    if (linkHeader) {
                        const match = linkHeader.match(/&page=(\d+)>; rel="last"/);
                        if (match) {
                            totalCommits = match[1];
                        }
                    } else {
                        totalCommits = commitsData.length; // fallback for repos with very few commits
                    }

                    let latestRelease = null;
                    try {
                        const releaseResponse = await fetch(`https://api.github.com/repos/${owner}/${repo}/releases/latest`);
                        latestRelease = await releaseResponse.json();

                        if (latestRelease.message === "Not Found" && latestRelease.status === "404") {
                            latestRelease = null; // No releases exist, so set to null
                        }
                    } catch (releaseError) {
                        latestRelease = null; // No releases found
                    }

                    const stars = repoData.stargazers_count;
                    const openIssues = repoData.open_issues_count;
                    const lastCommitDate = new Date(commitsData[0].commit.author.date).toLocaleDateString();
                    const authorName = commitsData[0].commit.author.name;
                    const authorAvatar = commitsData[0].author.avatar_url;
                    const commitMessage = commitsData[0].commit.message;

                    // Conditionally hide release section if no release exists
                    const releaseSection = latestRelease ? `
                    <div class="flex flex-col items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-6 h-6 text-green-500 mb-1">
                            <path fill-rule="evenodd" d="M4.5 2A2.5 2.5 0 0 0 2 4.5v2.879a2.5 2.5 0 0 0 .732 1.767l4.5 4.5a2.5 2.5 0 0 0 3.536 0l2.878-2.878a2.5 2.5 0 0 0 0-3.536l-4.5-4.5A2.5 2.5 0 0 0 7.38 2H4.5ZM5 6a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
                        </svg>
                        <span class="text-2xl font-bold">${latestRelease.tag_name}</span>
                        <span class="text-xs text-gray-500 dark:text-gray-400 mt-1 uppercase">Latest Release</span>
                    </div>
                ` : ''; // If no latest release, don't display this section

                    githubDataContainer.innerHTML = `
                <div class="flex flex-col gap-6 items-center justify-center text-center w-full">
                    <div class="flex gap-4 items-center">
                        <img src="${authorAvatar}" alt="${authorName}'s avatar" class="w-12 h-12 rounded-full shadow-md" />
                        <div class="flex flex-col ml-4">
                            <p class="text-lg text-gray-800 dark:text-gray-300 font-semibold italic max-w-md" title="${commitMessage}">
                                ${commitMessage}
                            </p>
                            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                                Last commit by <strong>${authorName}</strong> on ${lastCommitDate}
                            </p>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-8 text-center">
                        <div class="flex flex-col items-center">   
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-6 h-6 text-yellow-500 mb-1">
                                <path fill-rule="evenodd" d="M8 1.75a.75.75 0 0 1 .692.462l1.41 3.393 3.664.293a.75.75 0 0 1 .428 1.317l-2.791 2.39.853 3.575a.75.75 0 0 1-1.12.814L7.998 12.08l-3.135 1.915a.75.75 0 0 1-1.12-.814l.852-3.574-2.79-2.39a.75.75 0 0 1 .427-1.318l3.663-.293 1.41-3.393A.75.75 0 0 1 8 1.75Z" clip-rule="evenodd" />
                            </svg>
                            <span class="text-2xl font-bold">${stars}</span>
                            <span class="text-xs text-gray-500 dark:text-gray-400 mt-1 uppercase">Stars</span>
                        </div>
                        <div class="flex flex-col items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-6 h-6 text-purple-500 mb-1">
                                <path d="M2 4a2 2 0 0 1 2-2h8a2 2 0 1 1 0 4H4a2 2 0 0 1-2-2ZM2 9.25a.75.75 0 0 1 .75-.75h10.5a.75.75 0 0 1 0 1.5H2.75A.75.75 0 0 1 2 9.25ZM2.75 12.5a.75.75 0 0 0 0 1.5h10.5a.75.75 0 0 0 0-1.5H2.75Z" />
                            </svg>
                            <span class="text-2xl font-bold">${openIssues}</span>
                            <span class="text-xs text-gray-500 dark:text-gray-400 mt-1 uppercase">Open Issues</span>
                        </div>
                        <div class="flex flex-col items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="w-6 h-6 text-blue-500 mb-1">
                            <path fill-rule="evenodd" d="M1 8a7 7 0 1 1 14 0A7 7 0 0 1 1 8Zm7.75-4.25a.75.75 0 0 0-1.5 0V8c0 .414.336.75.75.75h3.25a.75.75 0 0 0 0-1.5h-2.5v-3.5Z" clip-rule="evenodd" />
                            </svg>
                            <span class="text-2xl font-bold">${totalCommits}</span>
                            <span class="text-xs text-gray-500 dark:text-gray-400 mt-1 uppercase">Commits</span>
                        </div>
                        ${releaseSection}
                    </div>
                </div>
            `;
                    spinner.classList.add("hidden");
                    githubDataContainer.classList.remove("hidden");
                } catch (error) {
                    githubDataContainer.innerHTML = `
            <p class="text-red-500 text-sm font-semibold text-center">Failed to load GitHub repository data. Please try again later.</p>
        `;
                    spinner.classList.add("hidden");
                    githubDataContainer.classList.remove("hidden");
                }
            }
            fetchGitHubData(repoURL);
        }
    </script>
</PageLayout>
